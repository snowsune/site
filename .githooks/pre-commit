#!/usr/bin/env bash
# Format staged Python with black and include the result in this commit.
# Matches CI: exclude migrations.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r -d '' file; do
  if [[ "$file" == *"/migrations/"* || "$file" == migrations/* ]]; then
    continue
  fi
  files+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.py')

if ((${#files[@]} == 0)); then
  exit 0
fi

run_black() {
  if command -v pipenv >/dev/null 2>&1 && [[ -f Pipfile ]]; then
    pipenv run black "$@"
  elif command -v black >/dev/null 2>&1; then
    black "$@"
  else
    echo "pre-commit: black not found (install black, or use pipenv with black available)" >&2
    exit 1
  fi
}

echo "pre-commit: running black..."
run_black "${files[@]}"
git add -- "${files[@]}"
echo "pre-commit: black ok"
